 "notes": [
  {
   "title": "Kurang sikit boleh?",
   "body": "“Can it be a bit less?” — the standard opening move. Smile when you say it; this is a game both sides know."
  },
  {
   "title": "… lah",
   "body": "<b>lah</b> softens a counter-offer: <i>dua puluh lima lah</i> — come on, twenty-five. Sellers answer in kind: <i>okay lah</i>."
  },
  {
   "title": "mampu and rugi",
   "body": "<b>Tak mampu</b> = can't afford it. <b>Rugi</b> = a loss: the seller says <i>rugi saya</i> (I'd lose money); friends say <i>rugi kalau tak beli</i> (you'd lose out not buying)."
  }
 ],

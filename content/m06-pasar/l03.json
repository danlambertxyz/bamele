  "voice": "m"
 },
 "notes": [
  {
   "title": "biji, kilo, papan",
   "body": "Fruit and eggs are counted in <b>biji</b>: <i>lima biji epal</i>. Most other things go by <b>kilo</b>. A tray of thirty eggs is <b>sepapan</b>; half a tray is <i>setengah papan</i>."
  },
  {
   "title": "setengah",
   "body": "<b>Setengah</b> = half: <i>setengah kilo</i>. <b>Sekilo setengah</b> = a kilo and a half."
  },
  {
   "title": "Lagi?",
   "body": "The stallholder's “anything else?” Answer with the next item, or <b>itu je</b> — that's all."
  }
 ],

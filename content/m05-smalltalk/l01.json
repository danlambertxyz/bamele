 "notes": [
  {
   "title": "aku and kau",
   "body": "With friends it's <b>aku</b> (I) and <b>kau</b> (you). With people you don't know well, or at work, it's <b>saya</b> and <b>awak</b>. You'll hear both in this module."
  },
  {
   "title": "Dah makan?",
   "body": "“Have you eaten?” is as much a greeting as a question. <i>Dah</i> (already) or <i>belum</i> (not yet) are the two answers."
  },
  {
   "title": "Spoken spellings",
   "body": "People write the way they talk: <b>pegi</b> for pergi, <b>ambik</b> for ambil, <b>gak</b> for juga, <b>takde</b> for tiada."
  }
 ],

 "notes": [
  {
   "title": "… ke?",
   "body": "Tack <b>ke</b> onto the end and a statement becomes a question: <i>Penat ke?</i> — tired, are you?"
  },
  {
   "title": "kena",
   "body": "<b>kena</b> + verb means “have to”: <i>kena rehat</i>, <i>kena masuk kerja</i>. Before a noun it means you got hit by it: <i>kena COVID</i>."
  },
  {
   "title": "sekali",
   "body": "At the start of a clause in a story, <b>sekali</b> means “and then, all of a sudden”: <i>Sekali bos panggil…</i>"
  }

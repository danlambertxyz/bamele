 "notes": [
  {
   "title": "gila and betul",
   "body": "After an adjective, <b>gila</b> (crazy) and <b>betul</b> (really) are intensifiers: <i>best gila</i>, <i>bising betul</i>. Very common, very casual."
  },
  {
   "title": "tak kisah",
   "body": "<b>Aku tak kisah</b> — I don't mind, either way is fine. <b>Malas aku nak kisah</b> is stronger: I can't be bothered to care."
  },
  {
   "title": "camtu, camna",
   "body": "Squeezed forms of <i>macam itu</i> (like that) and <i>macam mana</i> (how): <b>camtu</b>, <b>camna</b>."
  }
 ],

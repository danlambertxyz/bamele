 "notes": [
  {
   "title": "Dah sampai mana?",
   "body": "Literally “arrived where already?” — the standard call or text to someone who is late."
  },
  {
   "title": "sempat",
   "body": "<b>Sempat</b> means there's enough time: <i>sempat</i> (we'll make it), <i>tak sempat</i> (we won't)."
  },
  {
   "title": "diorang, kitorang, korang",
   "body": "Spoken plurals: <b>diorang</b> (they), <b>kitorang</b> (we, not you), <b>korang</b> (you all). They come from <i>dia orang</i>, <i>kita orang</i>, <i>kau orang</i>."
  }
 ],

 "notes": [
  {
   "title": "jom",
   "body": "<b>Jom</b> is “let's”: <i>jom makan</i>, <i>jom pergi</i>. <b>Jomlah!</b> on its own is “come on, let's do it!”"
  },
  {
   "title": "mungkin",
   "body": "<b>Mungkin</b> (maybe) is the polite way to stay non-committal: <i>Esok mungkin aku jumpa kau.</i>"
  },
  {
   "title": "tak boleh",
   "body": "<b>Tak boleh</b> covers “can't”, “not allowed” and “doesn't work for me”. Add the day and you have a full excuse: <i>Isnin tak boleh.</i>"
  }
 ],
